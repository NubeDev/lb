catalog-version: 1
# Built-in Spanish (es) catalog — the same keys as en.mf, MF1 subset messages. es cardinal plural
# is the same two categories as en (one iff n == 1) per CLDR 44. Kept key-for-key with en so a
# missing es key falls back to the en builtin (the language → en → key chain).

alert.threshold_crossed = {name} superó {limit, quantity, speed} el {ts, date}
alert.items_pending = Tienes {count, plural, =0{ningún elemento pendiente} one{# elemento pendiente} other{# elementos pendientes}}
alert.severity = {level, select, critical{Alerta crítica} warning{Advertencia} other{Aviso}}: {detail}
notify.welcome = ¡Bienvenido, {name}!
notify.new_messages = {name} te envió {count, plural, one{un mensaje} other{# mensajes}}
report.reading = Lectura: {value, quantity, temperature} registrada el {ts, date}
invite.email.subject = Te han invitado a unirte a {workspace}
invite.email.body = Has sido invitado al espacio de trabajo {workspace}. Haz clic en el enlace para aceptar: /accept?token={token}
invite.email.body_html = <p>Has sido invitado al espacio de trabajo <strong>{workspace}</strong>.</p><p><a href="/accept?token={token}">Aceptar la invitación</a></p>

# El circuito con el contratista (case-plane scope, wave 2). `case.request.send` envía a una parte un
# enlace a una página con token; después la escalera la avisa al 50 %/80 % de su ventana. Ambas
# acciones toman su texto del NOMBRE DE LA ACCIÓN (`request_link` / `request_nudge` →
# `{action}.email.*`). `{token}` es el token del enlace en crudo: existe solo aquí y en el correo.
request_link.email.subject = {has_subject, select, yes{{subject}} other{Acción requerida: {title}{has_site, select, yes{ en {site}} other{}}{has_reference, select, yes{ ({reference})} other{}}}}
request_link.email.body = {has_message, select, yes{{message}} other{Hola,\n\n{has_sender, select, yes{{sender} ha} other{Hemos}} detectado {title}{has_site, select, yes{ en {site}} other{}}.{has_finding, select, yes{\n{finding}} other{}}\n\nResponde cuando lo hayas atendido.}}\n\nResponde aquí: {base_url}/r/{token}
request_link.email.body_html = {has_message, select, yes{{message_html}} other{<p>Hola,</p><p>{has_sender, select, yes{{sender_html} ha} other{Hemos}} detectado {title_html}{has_site, select, yes{ en {site_html}} other{}}.{has_finding, select, yes{<br>{finding_html}} other{}}</p><p>Responde cuando lo hayas atendido.</p>}}<p><a href="{base_url}/r/{token}">Responde aquí</a></p>
# El aviso NO lleva enlace, deliberadamente: el token en crudo existe una sola vez (en el correo
# original) y no se puede recuperar del hash almacenado, así que el recordatorio remite al correo que
# ya tienen.
request_nudge.email.subject = Recordatorio: {has_reference, select, yes{{reference}: } other{}}un trabajo espera tu respuesta
request_nudge.email.body = Un trabajo{has_reference, select, yes{ ({reference})} other{}} sigue esperando tu respuesta. Abre el enlace de la solicitud que te enviamos antes y responde.
request_nudge.email.body_html = <p>Un trabajo{has_reference, select, yes{ ({reference})} other{}} sigue esperando tu respuesta.</p><p>Abre el enlace de la solicitud que te enviamos antes y responde.</p>
